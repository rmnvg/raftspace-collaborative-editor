# Supabase project URL (safe to expose to the client)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe to expose to the client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used exclusively in server-side code (route handlers / server actions) for
# authorization checks and privileged writes. Do not expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
